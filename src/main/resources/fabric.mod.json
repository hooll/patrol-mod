    "patrol-mod.mixins.json"
  ],
  "entrypoints": {
    "client": [
      "com.hooll.patrol.PatrolMod"
    ]
  },
  "depends": {
    "fabricloader": ">=0.18.2",
    "minecraft": "1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  }
